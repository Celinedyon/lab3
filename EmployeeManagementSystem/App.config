<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <appSettings>
        <!-- Configure these for a real SMTP provider. For local testing, use MailHog: host=localhost, port=1025, ssl=false. -->
        <add key="EMS_SMTP_HOST" value="" />
        <add key="EMS_SMTP_PORT" value="587" />
        <add key="EMS_SMTP_USER" value="" />
        <add key="EMS_SMTP_PASSWORD" value="" />
        <add key="EMS_SMTP_FROM" value="" />
        <add key="EMS_SMTP_SSL" value="true" />
    </appSettings>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
</configuration>